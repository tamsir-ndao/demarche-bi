# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# --- IA principale : Groq (API compatible OpenAI, modèles open source) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Effort de raisonnement envoyé au modèle. Vide : « low » pour gpt-oss-120b, rien pour les autres modèles.
AI_REASONING_EFFORT=

# --- IA de secours (optionnelle) ---
# Rien à régler avec Groq : le secours est alors un second modèle de Groq (qwen/qwen3.8-27b), puis un troisième
# (openai/gpt-oss-20b), avec la même clé. Chaque modèle a ses propres plafonds de tokens (par minute et par jour) :
# le suivant prend le relais quand le précédent est saturé.
# Pour un autre fournisseur (par exemple OpenRouter), renseigner la clé ET le modèle : les noms
# de modèles gratuits changent souvent, vérifier dans la liste du fournisseur.
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# --- Transcription vocale : Whisper via Groq ---
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# --- Base de données Neon (OPTIONNELLE) : journal anonyme et avis des utilisateurs ---
# L'application fonctionne sans. Serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
DATABASE_URL=

# --- Purge automatique du journal (production) : secret que Vercel envoie à la tâche planifiée ---
# Sans lui, /api/cron/purge refuse toute demande. Une longue valeur au hasard (voir docs/SETUP.md).
CRON_SECRET=

# --- Développement uniquement : inclure les fiches au statut "brouillon" dans les réponses ---
# Ne jamais activer en production : seules les fiches vérifiées doivent répondre aux citoyens.
DEMARCHE_INCLUDE_DRAFTS=false
