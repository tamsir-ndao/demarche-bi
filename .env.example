# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# --- IA principale : Groq (API compatible OpenAI, modèles open source) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- IA de secours : OpenRouter (optionnel, utilisée si Groq échoue) ---
# Vérifier le nom exact du modèle gratuit dans la liste des modèles OpenRouter.
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Transcription vocale : Whisper via Groq ---
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# --- Base de données Neon (OPTIONNELLE) : journal anonyme et avis des utilisateurs ---
# L'application fonctionne sans. Serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
DATABASE_URL=

# --- Développement uniquement : inclure les fiches au statut "brouillon" dans les réponses ---
# Ne jamais activer en production : seules les fiches vérifiées doivent répondre aux citoyens.
DEMARCHE_INCLUDE_DRAFTS=false
